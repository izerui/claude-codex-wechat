{
  "databasePath": "/Users/you/.claude-codex-wechat/bridge.sqlite",
  "wechat": {
    "enabled": true,
    "mode": "direct",
    "baseUrl": "https://ilinkai.weixin.qq.com",
    "token": "replace-with-weixin-bot-token",
    "accountId": "replace-with-weixin-account-id"
  },
  "providers": {
    "claude": {
      "command": "/opt/homebrew/bin/claude"
    },
    "codex": {
      "command": "/opt/homebrew/bin/codex"
    }
  },
  "tunnel": {
    "provider": "relay",
    "enabled": false,
    "relay": {
      "serverUrl": "wss://wechat.style520.com/agent",
      "authToken": "replace-with-relay-auth-token"
    }
  }
}
